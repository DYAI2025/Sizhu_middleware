# ---------------------------------------------------------------------------
# Model gateway (REQ-A-002) — OpenRouter is the ONLY default model gateway.
# Server-side only: NEVER give these a VITE_ prefix (would leak into the bundle).
# The API key is read via the secret-ref/env pattern; status endpoints report
# only `present: boolean` and never echo the value.
# ---------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Leave empty by default — the operator supplies the real key. No forced value.
OPENROUTER_API_KEY=
# Optional secret-ref indirection (defaults to the var above when unset).
OPENROUTER_API_KEY_SECRET_REF=SECRET_REF_OPENROUTER_API_KEY
# Optional per-operation model overrides (empty -> built-in defaults apply).
OPENROUTER_MODEL_IMAGE_GENERATION=
OPENROUTER_MODEL_QUALITY_GATE=

# Gemini / OpenAI are NOT default gateways. Do NOT force a default value here —
# OpenRouter is the single default model gateway (REQ-A-002). If you opt in to a
# direct provider, set it in your own deployment env, not in this shipped default.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Railway / Domain Settings
APP_MODE=CONFIG_REQUIRED
PUBLIC_APP_BASE_URL=https://sizhu.fufire.space
ALLOWED_ORIGINS=https://sizhu.fufire.space,http://localhost:5173,http://localhost:3000
RAILWAY_PUBLIC_DOMAIN=sizhu.fufire.space

# FuFire API Configuration
FUFIRE_BASE_URL=https://api.fufire.space
# Secret-ref INDIRECTION: the code reads the key from process.env[<this value>].
# So the actual key MUST be set under the env var NAMED here, i.e. by default
# under `SECRET_REF_FUFIRE_API_KEY` (NOT under `FUFIRE_API_KEY`). On Railway,
# /api/readiness returns 503 NOT_READY until that exact var is present.
FUFIRE_API_KEY_SECRET_REF=SECRET_REF_FUFIRE_API_KEY
# Put the real FuFire key here (the var named by FUFIRE_API_KEY_SECRET_REF above):
SECRET_REF_FUFIRE_API_KEY=
# (Alternative: set FUFIRE_API_KEY_SECRET_REF=FUFIRE_API_KEY and put the key under FUFIRE_API_KEY.)
FUFIRE_AUTH_HEADER_NAME=X-API-Key
FUFIRE_TIMEOUT_MS=15000
FUFIRE_RETRY_COUNT=1

# Supabase Configuration (server-side)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_SECRET_REF=SECRET_REF_SUPABASE_SERVICE_ROLE
# Project JWT secret, used for local (HS256) verification of access tokens.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Auth / Authorization (Iteration 8)
# ---------------------------------------------------------------------------
# Enforce authentication on all admin APIs. Fail-closed default is true.
AUTH_REQUIRED=true
# Require a verified second factor (aal2) for sensitive actions.
MFA_REQUIRED_FOR_SENSITIVE_ACTIONS=true
# Comma-separated admin emails. Each allowlisted email is granted the `owner`
# role for the MVP. This is how you bootstrap the first admin.
ADMIN_EMAIL_ALLOWLIST=

# ---------------------------------------------------------------------------
# Frontend (Vite) — only PUBLIC values may be exposed with the VITE_ prefix.
# The service-role key and JWT secret must NEVER be given a VITE_ prefix.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Display-only: lets the UI show the expected role. Server still enforces.
VITE_ADMIN_EMAIL_ALLOWLIST=
